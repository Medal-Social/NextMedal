# ====================
# REQUIRED VARIABLES
# ====================
# These MUST be set for the app to work

# Your Sanity project ID (get from https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Base URL of your site (use http://localhost:3000 for local development)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ====================
# OPTIONAL VARIABLES
# ====================

# Sanity API token with read permissions for live preview (optional but recommended)
# Create at: https://www.sanity.io/manage → Your Project → API → Tokens
# Permissions needed: Viewer
NEXT_PUBLIC_SANITY_BROWSER_TOKEN=

# Sanity API Version (defaults to 2025-12-23 if not set)
# Format: YYYY-MM-DD (e.g., 2025-12-23)
# See changelog: https://www.sanity.io/docs/api-changelog
# NEXT_PUBLIC_SANITY_API_VERSION=2025-12-23

# Hosted Studio app for `sanity deploy` (forks only; lowercase letters and digits).
# Leave empty on a fork's first deploy: Sanity creates the app and prints its id.
# The NextMedal project's own app is set in src/sanity/lib/studio-deployment.ts.
# SANITY_STUDIO_APP_ID=

# ====================
# ANALYTICS (OPTIONAL)
# ====================

# Umami Analytics
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ====================
# ADVANCED (OPTIONAL)
# ====================

# Environment type (development, staging, preview, production)
# NEXT_PUBLIC_APP_ENV=development

# Serve /qa/social-embeds even on production (default: off — prod returns 404).
# Read on every request from the server process, so set it when the process
# starts (`docker run -e ALLOW_QA_SOCIAL_EMBEDS=1`). It is not a Docker build
# argument. Staging/preview/dev always allow the fixture for Lighthouse. Set
# to 1/true only for a deliberate production audit; the page stays noindex
# and out of the sitemap.
# ALLOW_QA_SOCIAL_EMBEDS=1

# Custom image proxy URL
# NEXT_PUBLIC_IMAGE_PROXY_URL=

# Medal Social API (single bearer key in SDK 1.x — replaces the
# legacy CLIENT_ID/CLIENT_SECRET pair). Required for forms: contact forms,
# newsletter sign-ups and event registrations go to Medal Social only
# (nothing is stored in Sanity — the dataset is public). Without it every
# form answers "We couldn't send your message right now". Key scopes:
# read:contacts (look up returning visitors, read their timeline) and
# write:contacts (create/update contacts, add notes) — in dotted form
# crm.contact.read + crm.activity.read + write:contacts + crm.contact.note.create.
# MEDAL_API_KEY=
# MEDAL_API_ENDPOINT=
