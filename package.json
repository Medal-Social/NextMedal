{
  "name": "@medalsocial/nextmedal",
  "version": "1.0.0",
  "description": "Medal Social Template NextMedal",
  "author": "Medal Social <hi@medalsocial.com> (https://www.medalsocial.com)",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": "use pnpm instead - see packageManager field",
    "yarn": "use pnpm instead - see packageManager field"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf .next ",
    "intent": "tsx scripts/setup.ts",
    "dev": "next dev",
    "prebuild": "pnpm generate:collections",
    "build": "next build",
    "start": "next start",
    "preview": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && wrangler deploy --env production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:collections": "tsx scripts/generate-collections.ts",
    "setup:check": "npx tsx src/scripts/validate-setup.ts",
    "lint": "biome check .",
    "format": "biome format . --write",
    "manifest": "SANITY_CLI_EXTRACT_MANIFEST_ENABLED=false echo 'Manifest extraction disabled'",
    "typecheck": "tsc --noEmit",
    "validate": "sanity-template-validate",
    "docker:build": "./scripts/docker-build.sh",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --project=unit",
    "test:components": "vitest --run --project=components",
    "test:integration": "vitest --run --project=integration",
    "test:contracts": "vitest --run --project=contracts",
    "e2e": "playwright test --project=e2e",
    "e2e:smoke": "playwright test --project=smoke",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "e2e:a11y": "playwright test --project=accessibility",
    "e2e:perf": "playwright test --project=performance",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:all": "playwright test",
    "perf:budget": "npx tsx src/scripts/validate-performance-budget.ts",
    "perf:budget:verbose": "npx tsx src/scripts/validate-performance-budget.ts --verbose",
    "perf:validate": "pnpm build && pnpm perf:budget && pnpm e2e:perf",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@medalsocial/sdk": "^1.2.1",
    "@mux/mux-player": "^3.13.0",
    "@mux/mux-player-react": "^3.13.0",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/code-input": "^7.1.2",
    "@sanity/document-internationalization": "^6.2.2",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^3.2.0",
    "@sanity/vision": "^5.30.0",
    "@tailwindcss/postcss": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "isomorphic-dompurify": "^3.16.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "motion": "^12.40.0",
    "next": "^16.2.8",
    "next-intl": "^4.13.0",
    "next-safe-action": "^8.5.3",
    "next-sanity": "^13.0.11",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "pino": "^10.3.1",
    "postcss-load-config": "^6.0.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-player": "^3.4.0",
    "sanity": "^5.30.0",
    "sanity-plugin-media": "^4.3.1",
    "sanity-plugin-mux-input": "^2.19.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.6.0",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.4.16",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@sanity/language-filter": "^5.0.3",
    "@sanity/template-validator": "^3.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/intent": "0.0.41",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "only-allow": "^1.2.2",
    "pino-pretty": "^13.1.3",
    "playwright-lighthouse": "^4.0.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "sanity-plugin-internationalized-array": "^5.1.3",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.99.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "fast-uri": ">=3.1.2",
      "follow-redirects": ">=1.16.0",
      "lodash": ">=4.17.24",
      "markdown-it": ">=14.1.1",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "prismjs": ">=1.30.0",
      "uuid@>=11.0.0 <11.1.1": ">=11.1.1",
      "yaml": ">=2.8.3"
    }
  }
}
