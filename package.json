{
  "name": "@medalsocial/nextmedal",
  "version": "1.0.0",
  "description": "Medal Social Template NextMedal",
  "author": "Medal Social <hi@medalsocial.com> (https://www.medalsocial.com)",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": "use pnpm instead - see packageManager field",
    "yarn": "use pnpm instead - see packageManager field"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf .next ",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:sanity": "npx tsx src/scripts/lint-sanity-schemas.ts",
    "migrate:inline-types": "npx tsx src/scripts/migrate-inline-types.ts",
    "format": "biome format . --write",
    "manifest": "SANITY_CLI_EXTRACT_MANIFEST_ENABLED=false echo 'Manifest extraction disabled'",
    "typecheck": "tsc --noEmit",
    "validate": "sanity-template-validate",
    "docker:build": "./src/scripts/docker-build.sh",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --project=unit",
    "test:components": "vitest --run --project=components",
    "test:integration": "vitest --run --project=integration",
    "test:contracts": "vitest --run --project=contracts",
    "e2e": "playwright test --project=e2e",
    "e2e:smoke": "playwright test --project=smoke",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "e2e:a11y": "playwright test --project=accessibility",
    "e2e:perf": "playwright test --project=performance",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:all": "playwright test",
    "load": "k6 run tests/load/scripts/homepage.js",
    "load:homepage": "k6 run tests/load/scripts/homepage.js",
    "load:search": "k6 run tests/load/scripts/api-search.js",
    "load:all": "k6 run tests/load/scripts/homepage.js && k6 run tests/load/scripts/api-search.js",
    "load:stress": "k6 run --vus 100 --duration 2m tests/load/scripts/homepage.js",
    "load:spike": "k6 run --stage 10s:10,5s:200,10s:10,10s:0 tests/load/scripts/homepage.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@medalsocial/sdk": "latest",
    "@mux/mux-player": "^3.10.2",
    "@mux/mux-player-react": "^3.10.2",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/code-input": "^7.0.2",
    "@sanity/document-internationalization": "^4.1.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.2",
    "@sanity/ui": "^3.1.11",
    "@sanity/vision": "^5.1.0",
    "@sentry/nextjs": "^10.32.1",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "geist": "^1.5.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.26",
    "next": "^16.1.1",
    "next-intl": "^4.6.1",
    "next-safe-action": "^8.0.11",
    "next-sanity": "^12.0.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.6",
    "pino": "^10.1.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-player": "^3.4.0",
    "sanity": "^5.1.0",
    "sanity-plugin-media": "^4.1.1",
    "sanity-plugin-mux-input": "^2.12.1",
    "sharp": "^0.34.5",
    "shiki": "^3.20.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.4.0",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "2.3.10",
    "@playwright/test": "^1.57.0",
    "@sanity/template-validator": "^2.4.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lighthouse": "^12.8.2",
    "pino-pretty": "^13.1.3",
    "playwright-lighthouse": "^4.0.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.2",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "vitest-axe": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "immer": "^11.1.0",
      "prismjs": "^1.30.0"
    }
  },
  "packageManager": "pnpm@10.26.2"
}
