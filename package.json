{
  "name": "@medalsocial/nextmedal",
  "version": "1.0.0",
  "description": "Medal Social Template NextMedal",
  "author": "Medal Social <hi@medalsocial.com> (https://www.medalsocial.com)",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": "use pnpm instead - see packageManager field",
    "yarn": "use pnpm instead - see packageManager field"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf .next ",
    "intent": "tsx scripts/setup.ts",
    "dev": "next dev",
    "prebuild": "pnpm generate:collections",
    "build": "next build",
    "start": "next start",
    "preview": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && wrangler deploy --env production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:collections": "tsx scripts/generate-collections.ts",
    "setup:check": "npx tsx src/scripts/validate-setup.ts",
    "lint": "biome check .",
    "format": "biome format . --write",
    "manifest": "SANITY_CLI_EXTRACT_MANIFEST_ENABLED=false echo 'Manifest extraction disabled'",
    "typecheck": "tsc --noEmit",
    "validate": "sanity-template-validate",
    "docker:build": "./scripts/docker-build.sh",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --project=unit",
    "test:components": "vitest --run --project=components",
    "test:integration": "vitest --run --project=integration",
    "test:contracts": "vitest --run --project=contracts",
    "e2e": "playwright test --project=e2e",
    "e2e:smoke": "playwright test --project=smoke",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "e2e:a11y": "playwright test --project=accessibility",
    "e2e:perf": "playwright test --project=performance",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:all": "playwright test",
    "perf:budget": "npx tsx src/scripts/validate-performance-budget.ts",
    "perf:budget:verbose": "npx tsx src/scripts/validate-performance-budget.ts --verbose",
    "perf:validate": "pnpm build && pnpm perf:budget && pnpm e2e:perf",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@medalsocial/sdk": "^1.6.0",
    "@mux/mux-player": "^3.13.2",
    "@mux/mux-player-react": "^3.13.2",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^7.26.2",
    "@sanity/code-input": "^7.3.8",
    "@sanity/document-internationalization": "^6.2.34",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.0.7",
    "@sanity/vision": "^6.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "isomorphic-dompurify": "^3.23.0",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.2",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "next-safe-action": "^8.6.1",
    "next-sanity": "^13.3.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pino": "^10.3.1",
    "postcss-load-config": "^6.0.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-player": "^3.4.0",
    "sanity": "^6.11.0",
    "sanity-plugin-media": "^6.1.7",
    "sanity-plugin-mux-input": "^5.0.12",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "^1.62.1",
    "@sanity/language-filter": "^5.0.18",
    "@sanity/template-validator": "^3.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/intent": "0.3.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "only-allow": "^1.2.2",
    "pino-pretty": "^13.1.3",
    "playwright-lighthouse": "^4.0.0",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "sanity-plugin-internationalized-array": "^5.2.3",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "adm-zip@<0.6.0": ">=0.6.0",
      "brace-expansion@>=2.0.0 <3.0.0": ">=2.1.4 <3.0.0",
      "brace-expansion@>=3.0.0 <6.0.0": ">=5.0.9 <6.0.0",
      "dompurify": ">=3.4.13",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "fast-uri": ">=3.1.2",
      "follow-redirects": ">=1.16.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "js-yaml@<4.0.0": ">=3.15.1 <4.0.0",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "json-2-csv": ">=5.5.11",
      "linkify-it": ">=5.0.2",
      "lodash": ">=4.17.24",
      "markdown-it": ">=14.2.0",
      "nanoid@<4.0.0": ">=3.3.18 <4.0.0",
      "nanoid@>=4.0.0 <5.1.16": ">=5.1.16 <6.0.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.23",
      "prismjs": ">=1.30.0",
      "sharp": ">=0.35.0",
      "smol-toml": ">=1.6.1",
      "tar": ">=7.5.21",
      "undici@<6.28.0": ">=6.28.0 <7.0.0",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8.0.0",
      "uuid@<11.1.1": ">=11.1.1 <12.0.0",
      "valibot": ">=1.4.2",
      "vite@>=6.0.0 <7.0.0": ">=6.4.3 <7.0.0",
      "vite@>=7.0.0 <8.0.0": ">=7.3.5 <8.0.0",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1 <9.0.0",
      "yaml": ">=2.8.3"
    }
  }
}
